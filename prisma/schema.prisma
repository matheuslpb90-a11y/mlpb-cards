generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String
  cpf          String
  cep          String
  street       String
  number       String
  complement   String    @default("")
  neighborhood String
  city         String
  state        String
  role         String    @default("CUSTOMER") // CUSTOMER | ADMIN
  googleId     String?   // login com Google (sem @unique para o "db push" da Vercel não travar)
  totpSecret   String    @default("") // verificação em duas etapas (aplicativo autenticador)
  totpEnabled  Boolean   @default(false)
  recoveryJson String    @default("[]") // códigos de recuperação (hash)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  orders       Order[]
}

model Session {
  id         String   @id // token aleatório (cookie)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  pending2fa Boolean  @default(false) // senha/Google ok, falta o código do aplicativo
  attempts   Int      @default(0)
}

model Card {
  id             String      @id @default(cuid())
  kind           String      @default("CARTA") // CARTA (avulsa) | PRODUTO (selado/acessório)
  category       String      @default("") // para produtos: Booster, Box, ETB, Acessórios...
  featured       Boolean     @default(false) // aparece em "Destaques" na tela de início
  name           String
  game           String      @default("Pokémon") // Pokémon, Magic, Yu-Gi-Oh!, One Piece...
  setName        String // coleção / edição
  number         String      @default("")
  rarity         String      @default("")
  condition      String      @default("NM") // M, NM, SP, MP, HP, DMG
  finish         String      @default("Normal") // Normal, Foil, Reverse Foil, Promo
  language       String      @default("Português")
  priceCents     Int
  compareAtCents Int? // preço original ("de"), para mostrar desconto
  stock          Int         @default(1)
  imageUrl       String      @default("")
  description    String      @default("")
  active         Boolean     @default(true) // false = retirada do catálogo
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]
}

model Order {
  id             String      @id @default(cuid())
  code           Int         @unique // número amigável do pedido, também usado como order_nsu
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  // AGUARDANDO_PAGAMENTO | PAGO | ACUMULANDO | ENVIADO | CANCELADO
  status         String      @default("AGUARDANDO_PAGAMENTO")
  shippingMethod String // PAC | SEDEX | ACUMULAR
  shippingCents  Int
  subtotalCents  Int
  totalCents     Int
  paymentUrl     String      @default("")
  transactionNsu String      @default("")
  receiptUrl     String      @default("")
  trackingCode   String      @default("")
  sfOrderId      String      @default("") // etiqueta SuperFrete
  sfStatus       String      @default("")
  createdAt      DateTime    @default(now())
  paidAt         DateTime?
  items          OrderItem[]
  boxId          String?
  box            Box?        @relation(fields: [boxId], references: [id], onDelete: SetNull)
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cardId     String
  card       Card   @relation(fields: [cardId], references: [id])
  name       String
  priceCents Int
  quantity   Int
}

// Imagens enviadas pelo painel (fotos de produtos/cartas), servidas em /api/imagens/[id]
model Image {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

// Configurações da loja editáveis pelo painel (logo, textos, links de redes sociais)
model Setting {
  key   String @id
  value String
}

// ---------------- Leilões (enquete no grupo do WhatsApp via Z-API) ----------------

model Auction {
  id                String       @id @default(cuid())
  code              Int          @unique // número do leilão (1º, 2º...)
  name              String
  description       String       @default("")
  imageUrl          String       @default("")
  startsAt          DateTime
  endsAt            DateTime
  paymentDays       Int          @default(3)
  // fórmulas: inicial = mercado - initialPct%; arremate = mercado + buyoutPct%
  initialPct        Int          @default(20)
  buyoutPct         Int          @default(30)
  defaultStepCents  Int? // vazio = automático pela faixa de valor
  oneReal           Boolean      @default(false) // todos os lotes começam em R$ 1,00
  infinitepayHandle String       @default("") // vazio = conta padrão da loja
  // AGENDADO | ATIVO | ENCERRADO | CANCELADO
  status            String       @default("AGENDADO")
  // POLL (enquete) ou TEXT (lance por mensagem "1.2 $55"); definido ao iniciar
  mode              String       @default("")
  visible           Boolean      @default(true)
  createdAt         DateTime     @default(now())
  lots              AuctionLot[]
  invoices          Invoice[]
}

model AuctionLot {
  id         String        @id @default(cuid())
  auctionId  String
  auction    Auction       @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  position   Int
  title      String
  imageUrl   String        @default("") // imagem spoiler do lote
  oneReal    Boolean       @default(false)
  hideMarket Boolean       @default(false)
  hideBuyout Boolean       @default(false)
  items      AuctionItem[]
}

// Cada carta do lote vira uma enquete no grupo
model AuctionItem {
  id             String        @id @default(cuid())
  lotId          String
  lot            AuctionLot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  position       Int
  cardId         String? // carta do estoque (opcional)
  name           String
  number         String        @default("")
  finish         String        @default("Normal") // variante: Normal, Foil, Reverse Foil, Promo
  condition      String        @default("NM")
  language       String        @default("Português")
  graded         Boolean       @default(false) // Raw x Graduada
  note           String        @default("") // referência (slab, eBay, riscos...)
  costCents      Int?
  marketCents    Int           @default(0)
  startOverride  Int? // inicial manual
  buyoutOverride Int? // arremate manual
  stepOverride   Int? // incremento manual
  hideMarket     Boolean       @default(false)
  hideBuyout     Boolean       @default(false)
  imageUrl       String        @default("")
  mediaJson      String        @default("[]") // [{url, type: "image" | "video"}]
  // calculados ao salvar
  startCents     Int           @default(100)
  stepCents      Int           @default(100)
  buyoutCents    Int           @default(0)
  optionsJson    String        @default("[]")
  pollMessageId  String        @default("")
  pollMapJson    String        @default("") // id-da-opção → texto (Whapi)
  winnerPhone    String        @default("")
  winnerName     String        @default("")
  winningCents   Int?
  votes          AuctionVote[]
}

model AuctionVote {
  id          String      @id @default(cuid())
  itemId      String
  item        AuctionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  phone       String
  name        String      @default("")
  optionCents Int
  votedAt     DateTime    @default(now())

  @@unique([itemId, phone])
}

model Invoice {
  id             String    @id @default(cuid())
  code           Int       @unique
  auctionId      String?
  auction        Auction?  @relation(fields: [auctionId], references: [id], onDelete: SetNull)
  phone          String
  name           String    @default("")
  itemsJson      String // [{title, cents}]
  totalCents     Int
  // PENDENTE | PAGO | CANCELADO
  status         String    @default("PENDENTE")
  dueAt          DateTime
  paymentUrl     String    @default("")
  transactionNsu String    @default("")
  receiptUrl     String    @default("")
  createdAt      DateTime  @default(now())
  paidAt         DateTime?
  sentAt         DateTime?
  boxId          String?
  box            Box?      @relation(fields: [boxId], references: [id], onDelete: SetNull)
}

// Registro das chamadas recebidas da Z-API (para conferência no painel)
model BotLog {
  id        String   @id @default(cuid())
  kind      String
  payload   String
  createdAt DateTime @default(now())
}

// Caixa do cliente: acumula arremates pagos e compras "acumular" até o envio
model Box {
  id             String    @id @default(cuid())
  code           Int       @unique
  token          String    @unique // link público da caixa (sem login)
  phone          String // só dígitos, com 55
  name           String    @default("")
  userId         String?
  // PENDENTE | FRETE_SOLICITADO | EM_SEPARACAO | ENVIADA | PRESENCIAL | CONCLUIDA
  status         String    @default("PENDENTE")
  shippingMethod String    @default("") // ex.: PAC, SEDEX, Mini Envios, GRATIS, RETIRADA
  shippingCents  Int       @default(0)
  shippingPaid   Boolean   @default(false)
  addressJson    String    @default("")
  trackingCode   String    @default("")
  sfOrderId      String    @default("") // etiqueta SuperFrete
  sfStatus       String    @default("")
  notes          String    @default("")
  archived       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  requestedAt    DateTime?
  closedAt       DateTime?
  orders         Order[]
  invoices       Invoice[]
}

// Registro de atividades do painel (quem fez o quê)
model ActivityLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  userId      String   @default("")
  userName    String   @default("")
  action      String
  description String
  ip          String   @default("")

  @@index([createdAt])
}

// Moderação do grupo: avisos (warn), anúncios do dia, silenciados (timeout)
model ModEvent {
  id        String    @id @default(cuid())
  group     String
  phone     String // chave do telefone (phoneKey)
  name      String    @default("")
  kind      String // WARN | AD | TIMEOUT
  note      String    @default("")
  until     DateTime?
  createdAt DateTime  @default(now())

  @@index([group, phone, kind])
}

// Pagamento consolidado: vários invoices pendentes do mesmo cliente num só pagamento (order_nsu "G" + código)
model PaymentGroup {
  id             String    @id @default(cuid())
  code           Int       @unique
  token          String    @unique // link público /pagar/[token]
  phone          String // phoneKey do cliente
  name           String    @default("")
  status         String    @default("ABERTO") // ABERTO | PAGO
  invoiceIdsJson String    @default("[]") // invoices incluídos no último link de pagamento gerado
  totalCents     Int       @default(0)
  paymentUrl     String    @default("")
  transactionNsu String    @default("")
  createdAt      DateTime  @default(now())
  paidAt         DateTime?
}

// Avaliações de entrega/negociação feitas no grupo (!avaliar / !referencias)
model Review {
  id          String   @id @default(cuid())
  targetPhone String // phoneKey de quem foi avaliado
  raterPhone  String // phoneKey de quem avaliou
  raterName   String   @default("")
  group       String   @default("")
  rating      Int // 1 a 5
  comment     String   @default("")
  proofJson   String   @default("[]") // imagens de comprovação [{mediaId, messageId}]
  createdAt   DateTime @default(now())

  @@index([targetPhone, createdAt])
}

// MLPB Points: extrato de pontos por membro do grupo (positivo = ganhou, negativo = trocou/ajuste)
model PointEntry {
  id        String    @id @default(cuid())
  phone     String // phoneKey
  name      String    @default("")
  points    Int
  source    String // COMPRA | LEILAO | LEILOMANIA | JOGO | AVALIACAO | INDICACAO | RANKING | RESGATE | AJUSTE
  note      String    @default("")
  refId     String    @default("") // pedido/invoice/etc. (evita lançar duas vezes)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([refId])
}

// Pedidos de troca de pontos por prêmio (aprovados pela loja)
model Redemption {
  id         String    @id @default(cuid())
  phone      String
  name       String    @default("")
  rewardKey  String
  rewardName String
  points     Int
  status     String    @default("PENDENTE") // PENDENTE | ENTREGUE | RECUSADO
  createdAt  DateTime  @default(now())
  doneAt     DateTime?
}

// Leilão de Pontos: enquete no grupo em que o lance é em MLPB Points
model PointAuction {
  id            String     @id @default(cuid())
  title         String
  imageUrl      String     @default("")
  optionsJson   String     @default("[]") // valores em pontos
  group         String     @default("")
  pollMessageId String     @default("")
  status        String     @default("ATIVO") // ATIVO | ENCERRADO
  endsAt        DateTime
  winnerPhone   String     @default("")
  winnerName    String     @default("")
  winnerPoints  Int?
  createdAt     DateTime   @default(now())
  bids          PointBid[]
}

model PointBid {
  id        String       @id @default(cuid())
  auctionId String
  auction   PointAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  phone     String
  name      String       @default("")
  points    Int
  votedAt   DateTime     @default(now())

  @@unique([auctionId, phone])
}

// Rodadas dos jogos do grupo (Quem é esse Pokémon?, Adivinhe o preço, Pokébola)
model GameRound {
  id          String   @id @default(cuid())
  type        String // POKEMON | PRECO | POKEBOLA
  group       String
  answer      String // nome do Pokémon / preço em centavos / dex
  dataJson    String   @default("{}")
  status      String   @default("ATIVO") // ATIVO | ENCERRADO
  endsAt      DateTime
  winnerPhone String   @default("")
  winnerName  String   @default("")
  createdAt   DateTime @default(now())

  @@index([status, endsAt])
}

// Palpites do "Adivinhe o preço" (1 por pessoa)
model GameGuess {
  id        String   @id @default(cuid())
  roundId   String
  phone     String
  name      String   @default("")
  cents     Int
  createdAt DateTime @default(now())

  @@unique([roundId, phone])
}

// Pokédex de cada membro (Pokébola)
model Capture {
  id        String   @id @default(cuid())
  phone     String
  name      String   @default("")
  dex       Int
  pokemon   String
  shiny     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

// Indicação premiada: quem entrou diz quem indicou
model Referral {
  id            String   @id @default(cuid())
  newPhone      String   @unique
  newName       String   @default("")
  referrerPhone String
  stayPaid      Boolean  @default(false)
  purchasePaid  Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// Leilões feitos em outra plataforma (ex.: Leilomania), mostrados na aba Leilões do site
model ExternalAuction {
  id          String   @id @default(cuid())
  platform    String   @default("Leilomania")
  title       String
  description String   @default("")
  url         String
  imageUrl    String   @default("") // capa (= primeira foto)
  imagesJson  String   @default("[]") // todas as fotos, em ordem
  startsAt    DateTime
  endsAt      DateTime
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
}
