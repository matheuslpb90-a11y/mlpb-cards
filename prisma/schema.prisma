generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String
  cpf          String
  cep          String
  street       String
  number       String
  complement   String    @default("")
  neighborhood String
  city         String
  state        String
  role         String    @default("CUSTOMER") // CUSTOMER | ADMIN
  createdAt    DateTime  @default(now())
  sessions     Session[]
  orders       Order[]
}

model Session {
  id        String   @id // token aleatório (cookie)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model Card {
  id             String      @id @default(cuid())
  kind           String      @default("CARTA") // CARTA (avulsa) | PRODUTO (selado/acessório)
  category       String      @default("") // para produtos: Booster, Box, ETB, Acessórios...
  featured       Boolean     @default(false) // aparece em "Destaques" na tela de início
  name           String
  game           String      @default("Pokémon") // Pokémon, Magic, Yu-Gi-Oh!, One Piece...
  setName        String // coleção / edição
  number         String      @default("")
  rarity         String      @default("")
  condition      String      @default("NM") // M, NM, SP, MP, HP, DMG
  finish         String      @default("Normal") // Normal, Foil, Reverse Foil, Promo
  language       String      @default("Português")
  priceCents     Int
  compareAtCents Int? // preço original ("de"), para mostrar desconto
  stock          Int         @default(1)
  imageUrl       String      @default("")
  description    String      @default("")
  active         Boolean     @default(true) // false = retirada do catálogo
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]
}

model Order {
  id             String      @id @default(cuid())
  code           Int         @unique // número amigável do pedido, também usado como order_nsu
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  // AGUARDANDO_PAGAMENTO | PAGO | ACUMULANDO | ENVIADO | CANCELADO
  status         String      @default("AGUARDANDO_PAGAMENTO")
  shippingMethod String // PAC | SEDEX | ACUMULAR
  shippingCents  Int
  subtotalCents  Int
  totalCents     Int
  paymentUrl     String      @default("")
  transactionNsu String      @default("")
  receiptUrl     String      @default("")
  trackingCode   String      @default("")
  createdAt      DateTime    @default(now())
  paidAt         DateTime?
  items          OrderItem[]
  boxId          String?
  box            Box?        @relation(fields: [boxId], references: [id], onDelete: SetNull)
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cardId     String
  card       Card   @relation(fields: [cardId], references: [id])
  name       String
  priceCents Int
  quantity   Int
}

// Imagens enviadas pelo painel (fotos de produtos/cartas), servidas em /api/imagens/[id]
model Image {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

// Configurações da loja editáveis pelo painel (logo, textos, links de redes sociais)
model Setting {
  key   String @id
  value String
}

// ---------------- Leilões (enquete no grupo do WhatsApp via Z-API) ----------------

model Auction {
  id                String       @id @default(cuid())
  code              Int          @unique // número do leilão (1º, 2º...)
  name              String
  description       String       @default("")
  imageUrl          String       @default("")
  startsAt          DateTime
  endsAt            DateTime
  paymentDays       Int          @default(3)
  // fórmulas: inicial = mercado - initialPct%; arremate = mercado + buyoutPct%
  initialPct        Int          @default(20)
  buyoutPct         Int          @default(30)
  defaultStepCents  Int? // vazio = automático pela faixa de valor
  oneReal           Boolean      @default(false) // todos os lotes começam em R$ 1,00
  infinitepayHandle String       @default("") // vazio = conta padrão da loja
  // AGENDADO | ATIVO | ENCERRADO | CANCELADO
  status            String       @default("AGENDADO")
  // POLL (enquete) ou TEXT (lance por mensagem "1.2 $55"); definido ao iniciar
  mode              String       @default("")
  visible           Boolean      @default(true)
  createdAt         DateTime     @default(now())
  lots              AuctionLot[]
  invoices          Invoice[]
}

model AuctionLot {
  id         String        @id @default(cuid())
  auctionId  String
  auction    Auction       @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  position   Int
  title      String
  imageUrl   String        @default("") // imagem spoiler do lote
  oneReal    Boolean       @default(false)
  hideMarket Boolean       @default(false)
  hideBuyout Boolean       @default(false)
  items      AuctionItem[]
}

// Cada carta do lote vira uma enquete no grupo
model AuctionItem {
  id             String        @id @default(cuid())
  lotId          String
  lot            AuctionLot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  position       Int
  cardId         String? // carta do estoque (opcional)
  name           String
  number         String        @default("")
  finish         String        @default("Normal") // variante: Normal, Foil, Reverse Foil, Promo
  condition      String        @default("NM")
  language       String        @default("Português")
  graded         Boolean       @default(false) // Raw x Graduada
  note           String        @default("") // referência (slab, eBay, riscos...)
  costCents      Int?
  marketCents    Int           @default(0)
  startOverride  Int? // inicial manual
  buyoutOverride Int? // arremate manual
  stepOverride   Int? // incremento manual
  hideMarket     Boolean       @default(false)
  hideBuyout     Boolean       @default(false)
  imageUrl       String        @default("")
  mediaJson      String        @default("[]") // [{url, type: "image" | "video"}]
  // calculados ao salvar
  startCents     Int           @default(100)
  stepCents      Int           @default(100)
  buyoutCents    Int           @default(0)
  optionsJson    String        @default("[]")
  pollMessageId  String        @default("")
  pollMapJson    String        @default("") // id-da-opção → texto (Whapi)
  winnerPhone    String        @default("")
  winnerName     String        @default("")
  winningCents   Int?
  votes          AuctionVote[]
}

model AuctionVote {
  id          String      @id @default(cuid())
  itemId      String
  item        AuctionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  phone       String
  name        String      @default("")
  optionCents Int
  votedAt     DateTime    @default(now())

  @@unique([itemId, phone])
}

model Invoice {
  id             String    @id @default(cuid())
  code           Int       @unique
  auctionId      String?
  auction        Auction?  @relation(fields: [auctionId], references: [id], onDelete: SetNull)
  phone          String
  name           String    @default("")
  itemsJson      String // [{title, cents}]
  totalCents     Int
  // PENDENTE | PAGO | CANCELADO
  status         String    @default("PENDENTE")
  dueAt          DateTime
  paymentUrl     String    @default("")
  transactionNsu String    @default("")
  receiptUrl     String    @default("")
  createdAt      DateTime  @default(now())
  paidAt         DateTime?
  sentAt         DateTime?
  boxId          String?
  box            Box?      @relation(fields: [boxId], references: [id], onDelete: SetNull)
}

// Registro das chamadas recebidas da Z-API (para conferência no painel)
model BotLog {
  id        String   @id @default(cuid())
  kind      String
  payload   String
  createdAt DateTime @default(now())
}

// Caixa do cliente: acumula arremates pagos e compras "acumular" até o envio
model Box {
  id             String    @id @default(cuid())
  code           Int       @unique
  token          String    @unique // link público da caixa (sem login)
  phone          String // só dígitos, com 55
  name           String    @default("")
  userId         String?
  // PENDENTE | FRETE_SOLICITADO | EM_SEPARACAO | ENVIADA | PRESENCIAL | CONCLUIDA
  status         String    @default("PENDENTE")
  shippingMethod String    @default("") // ex.: PAC, SEDEX, Mini Envios, GRATIS, RETIRADA
  shippingCents  Int       @default(0)
  shippingPaid   Boolean   @default(false)
  addressJson    String    @default("")
  trackingCode   String    @default("")
  notes          String    @default("")
  archived       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  requestedAt    DateTime?
  closedAt       DateTime?
  orders         Order[]
  invoices       Invoice[]
}

// Registro de atividades do painel (quem fez o quê)
model ActivityLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  userId      String   @default("")
  userName    String   @default("")
  action      String
  description String
  ip          String   @default("")

  @@index([createdAt])
}
