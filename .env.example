# Banco de dados (SQLite em dev; em produção use Postgres e troque o provider no schema.prisma)
DATABASE_URL="file:./dev.db"

# URL pública do site (usada nos retornos de pagamento)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp da loja: apenas números, com DDI 55 + DDD. Ex.: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER="5511999999999"

# InfinitePay: sua InfiniteTag (handle) SEM o "$". Deixe vazio para usar o modo demonstração.
INFINITEPAY_HANDLE=""

# Administrador inicial criado pelo `npm run db:seed`
ADMIN_EMAIL="admin@mlpbcards.com.br"
ADMIN_PASSWORD="troque-esta-senha"

# CEP de origem (de onde a loja envia) para o cálculo do frete
STORE_ORIGIN_CEP="01001000"
