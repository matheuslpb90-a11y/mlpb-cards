# Banco de dados Postgres (ex.: Neon). Cole aqui a "connection string".
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
# Conexão direta (sem pool). Se não tiver, repita o DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host/banco?sslmode=require"

# URL pública do site (usada nos retornos de pagamento). Na Vercel é detectada sozinha.
NEXT_PUBLIC_SITE_URL="https://www.mlpbcards.com.br"

# WhatsApp da loja: apenas números, com DDI 55 + DDD. Ex.: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER="5561992242345"

# InfinitePay: InfiniteTag da loja SEM o "$". Deixe vazio ("") para usar o modo demonstração.
INFINITEPAY_HANDLE="mlpbcards"

# Administrador inicial criado pelo `npm run db:seed`
ADMIN_EMAIL="admin@mlpbcards.com.br"
ADMIN_PASSWORD=""   # mínimo 8 caracteres

# Frete — SuperFrete (https://web.superfrete.com → Integrações → gerar token)
# Deixe SUPERFRETE_TOKEN vazio para usar a tabela regional de teste.
SUPERFRETE_TOKEN=""
# 1 = PAC, 2 = SEDEX, 17 = Mini Envios
SUPERFRETE_SERVICES="1,2,17"
# "1" para usar o ambiente de testes (sandbox) da SuperFrete
SUPERFRETE_SANDBOX="0"
# CEP de onde a loja envia as cartas (obrigatório com a SuperFrete)
STORE_ORIGIN_CEP="70675827"

# "1" para criar 3 cartas de exemplo
SEED_SAMPLE_CARDS="0"

# Bot do WhatsApp — Z-API clássica (enquetes) OU Z-API Omni (lance por mensagem)
# Omni: ZAPI_INSTANCE_ID = ID do canal, ZAPI_TOKEN = token do canal, ZAPI_SECRET_KEY = Secret Key (Segurança)
# Clássica: deixe ZAPI_SECRET_KEY vazio e use ZAPI_CLIENT_TOKEN
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
# "Token de segurança da conta" (Client-Token) da Z-API
ZAPI_CLIENT_TOKEN=""
